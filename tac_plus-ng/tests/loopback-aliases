#!/bin/sh
# Add the local addresses of the tests to lo/lo0 (Linux, FreeBSD, OpenBSD; run as root).
#
# Linux makes all of 127.0.0.0/8 local. The BSDs have only 127.0.0.1 on lo0,
# so a test that binds another loopback source fails there. The addresses
# come from the tests themselves: 127.0.0.2-254 and each other 127.x.y.z
# address that a test names (network addresses ending in .0 excepted), on
# the BSDs only; and on every system each fd00:7ac::/64 address, the second
# local IPv6 address of the tests.

set -e

TESTS=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# grep exits 1 for no match, 2 for a file it cannot read
named=$(grep -ohE '127\.[0-9]+\.[0-9]+\.[0-9]+' "$TESTS"/*.py "$TESTS"/tactest/*.py) || [ $? -eq 1 ] || exit 1

addrs() {
	i=2
	while [ $i -le 254 ]; do
		echo 127.0.0.$i
		i=$((i + 1))
	done
	echo "$named" | grep -v '\.0$'
}

named6=$(grep -ohE 'fd00:7ac::[0-9a-f]+' "$TESTS"/*.py "$TESTS"/tactest/*.py) || [ $? -eq 1 ] || exit 1

# an address that the interface has stays as it is, also on a second run
n=0
if [ "$(uname -s)" = Linux ]; then
	have=$(ip -6 addr show dev lo)
else
	have=$(ifconfig lo0)
	for a in $(addrs | sort -u); do
		[ "$a" = 127.0.0.1 ] && continue
		case "$have" in *"inet $a "*) continue ;; esac
		ifconfig lo0 inet "$a/32" alias
		n=$((n + 1))
	done
fi
for a in $(echo "$named6" | sort -u); do
	if [ "$(uname -s)" = Linux ]; then
		case "$have" in *"inet6 $a/"*) continue ;; esac
		ip -6 addr add "$a/128" dev lo
	else
		case "$have" in *"inet6 $a "*) continue ;; esac
		ifconfig lo0 inet6 "$a/128" alias
	fi
	n=$((n + 1))
done
echo "loopback-aliases: $n addresses"
