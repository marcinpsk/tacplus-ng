#!/bin/sh
# Build and start the Samba AD DC of test_ldapmavis_ad.py, wait for LDAPS, print its TACTEST_SAMBA_* settings.
# usage: start [docker build arguments]; stop: docker rm -f tactest-samba-dc
set -eu
dir=$(cd "$(dirname "$0")" && pwd)
out=$(cd "$dir/../../.." && pwd)/build/samba-dc
name=tactest-samba-dc
base=DC=tactest,DC=example
mkdir -p "$out"
docker build -q -t "$name" "$@" "$dir" >&2
docker rm -f "$name" >/dev/null 2>&1 || true
password=Tt1-$(openssl rand -hex 12)
docker run -d --name "$name" --hostname dc1 -e ADMIN_PASSWORD="$password" -p 127.0.0.1::636 "$name" >/dev/null
port=$(docker port "$name" 636/tcp | sed -n 's/^127\.0\.0\.1://p')
i=0
until docker cp "$name:/etc/samba/tls/ca.pem" "$out/ca.pem" >/dev/null 2>&1 &&
	openssl s_client -connect "127.0.0.1:$port" -CAfile "$out/ca.pem" -verify_return_error </dev/null >/dev/null 2>&1; do
	i=$((i + 1))
	if [ $i -ge 120 ] || [ "$(docker inspect -f '{{.State.Running}}' "$name")" != true ]; then
		docker logs "$name" >&2
		echo "start: the DC does not answer on 127.0.0.1:$port" >&2
		exit 1
	fi
	sleep 1
done
echo "TACTEST_SAMBA_DC=ldaps://127.0.0.1:$port"
echo "TACTEST_SAMBA_BASE=$base"
echo "TACTEST_SAMBA_ADMIN=CN=Administrator,CN=Users,$base"
echo "TACTEST_SAMBA_PASSWORD=$password"
echo "TACTEST_SAMBA_CA=$out/ca.pem"
